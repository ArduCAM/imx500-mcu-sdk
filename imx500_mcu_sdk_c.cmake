set(IMX500_MCU_SDK_VERSION_U32 0x00000008)
set(IMX500_MCU_SDK_C_VERSION_U32 ${IMX500_MCU_SDK_VERSION_U32})

set(IMX500_MCU_SDK_SENSOR_MIPI_RESOLUTION "1024x600" CACHE STRING
    "IMX500 SDK sensor MIPI resolution: 1024x600, 1600x1200, 1280x720, or 640x480")
set_property(CACHE IMX500_MCU_SDK_SENSOR_MIPI_RESOLUTION PROPERTY STRINGS
    1024x600
    1600x1200
    1280x720
    640x480
)

if(IMX500_MCU_SDK_SENSOR_MIPI_RESOLUTION STREQUAL "1024x600")
    set(IMX500_MCU_SDK_SENSOR_MIPI_COMMAND SENSOR_MIPI_1024x600_2LANES)
    set(IMX500_MCU_SDK_SENSOR_MIPI_WIDTH 1024)
    set(IMX500_MCU_SDK_SENSOR_MIPI_HEIGHT 600)
elseif(IMX500_MCU_SDK_SENSOR_MIPI_RESOLUTION STREQUAL "1600x1200")
    set(IMX500_MCU_SDK_SENSOR_MIPI_COMMAND SENSOR_MIPI_1600x1200_2LANES)
    set(IMX500_MCU_SDK_SENSOR_MIPI_WIDTH 1600)
    set(IMX500_MCU_SDK_SENSOR_MIPI_HEIGHT 1200)
elseif(IMX500_MCU_SDK_SENSOR_MIPI_RESOLUTION STREQUAL "1280x720")
    set(IMX500_MCU_SDK_SENSOR_MIPI_COMMAND SENSOR_MIPI_1280x720_2LANES)
    set(IMX500_MCU_SDK_SENSOR_MIPI_WIDTH 1280)
    set(IMX500_MCU_SDK_SENSOR_MIPI_HEIGHT 720)
elseif(IMX500_MCU_SDK_SENSOR_MIPI_RESOLUTION STREQUAL "640x480")
    set(IMX500_MCU_SDK_SENSOR_MIPI_COMMAND SENSOR_MIPI_640x480_2LANES)
    set(IMX500_MCU_SDK_SENSOR_MIPI_WIDTH 640)
    set(IMX500_MCU_SDK_SENSOR_MIPI_HEIGHT 480)
else()
    message(FATAL_ERROR
        "Unsupported IMX500_MCU_SDK_SENSOR_MIPI_RESOLUTION=${IMX500_MCU_SDK_SENSOR_MIPI_RESOLUTION}; "
        "expected 1024x600, 1600x1200, 1280x720, or 640x480")
endif()

set(IMX500_MCU_SDK_C_COMPILE_DEFINITIONS
    IMX500_MCU_SDK_SENSOR_MIPI_COMMAND=${IMX500_MCU_SDK_SENSOR_MIPI_COMMAND}
    IMX500_MCU_SDK_SENSOR_MIPI_WIDTH=${IMX500_MCU_SDK_SENSOR_MIPI_WIDTH}
    IMX500_MCU_SDK_SENSOR_MIPI_HEIGHT=${IMX500_MCU_SDK_SENSOR_MIPI_HEIGHT}
)

function(imx500_mcu_sdk_c_apply_config target)
    target_compile_definitions(${target} PRIVATE
        ${IMX500_MCU_SDK_C_COMPILE_DEFINITIONS}
    )
endfunction()

set(IMX500_MCU_SDK_C_SRC_FILES
    ${CMAKE_CURRENT_LIST_DIR}/ArducamIMX500SDK.c
    ${CMAKE_CURRENT_LIST_DIR}/ai_driver.c
    ${CMAKE_CURRENT_LIST_DIR}/third_party/flatcc/src/runtime/verifier.c
)

configure_file(
    ${CMAKE_CURRENT_LIST_DIR}/version.h.in
    ${CMAKE_CURRENT_BINARY_DIR}/generated/version.h
    @ONLY
)

set(IMX500_MCU_SDK_C_INCLUDE_DIRS
    ${CMAKE_CURRENT_LIST_DIR}
    ${CMAKE_CURRENT_BINARY_DIR}/generated
    ${CMAKE_CURRENT_LIST_DIR}/apParams_c
    ${CMAKE_CURRENT_LIST_DIR}/third_party/flatcc/include
)

include_directories(
    ${IMX500_MCU_SDK_C_INCLUDE_DIRS}
)
